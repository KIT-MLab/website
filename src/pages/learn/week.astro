---
/**
 * 今週のページ（20-platform.md 第25.4節。試作の案B）。`/learn/week/`。
 *
 * 前回・今回・次回の3回を横に3列（今回の列に朱の枠。design/spec/54-week-pace.md 第4.1節）。各列に
 * この回の前に（予習）・この回でやること（前半・後半）・この回のあとに（復習）。その先の回は、3列の下に
 * 畳んだ行で並べ、開くと同じ中身が出る。3列の上に、各自で進める Python の復習の帯（第4.3節）。
 * 「今回」は `/learn/` の「次回」と同じ規則（`nextMeeting`。その日のうちはその日の回。日本時間）。
 *
 * 中身は src/lesson/plan.ts の行に書く（第25.4節）。**メンバーだけ**（第13.2節と同じ）: サーバで判じ、
 * メンバーでない人には1段落だけを返して中身を1文字も送らない。進み具合（練習の範囲・今週の演習）は
 * 手元の進度にしか無いので、ブラウザで src/lesson/practice-progress.ts が塗る。
 */
export const prerender = false;

import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import WeekMeeting from '../../components/lesson/WeekMeeting.astro';
import { currentUser, serverConfig } from '../../server/auth';
import { isMember, jstFormValues } from '../../server/member';
import { lessonIsPublic, publishView } from '../../server/lessons-publish';
import { openWeeklyIds } from '../../server/weekly';
import { chapterTitle } from '../../lesson/chapters';
import { practiceHref, practiceProblems, topicTitleText } from '../../lesson/practice';
import { PLAN, entranceDateLabel, selfReviewMarks, titleHalves, weekColumns, type PlanMeetRow, type PlanPractice, type WeekLink, type WeekView } from '../../lesson/plan';
// @ts-expect-error 節への行き先の組み立ては .mjs 側に1つだけ置く（src/lesson/weekly-syntax.ts と同じ理由）
import { sectionHref, sectionLabel } from '../../../scripts/section-refs.mjs';
import generated from '../../generated/lesson-data.json';
import '../../styles/lesson-tokens.css';
import '../../styles/member.css';

const config = serverConfig();
const me = config ? await currentUser(Astro.request) : null;
const member = me !== null && isMember(me);
const isStaff = me !== null && (me.role === 'staff' || me.role === 'admin');

Astro.response.headers.set('cache-control', 'no-store');

const today = jstFormValues(Date.now()).date;
const week = member ? weekColumns(PLAN, today) : { now: null, columns: [], later: [] };

// --- 行き先を引く表（メンバーのときだけ組む） ---
const published = member && config ? await publishView(config.db) : { chapters: new Set<string>(), sections: new Set<string>() };
const openWeekly = member && config && me ? await openWeeklyIds(config.db, me.cohort.code) : new Set<string>();
const lessons = member ? (await getCollection('lessons')).sort((a, b) => a.id.localeCompare(b.id)) : [];
const weeklySets = member ? await getCollection('weekly') : [];
const practiceTopics = member ? await getCollection('practice') : [];
const genWeekly = (generated as { weekly?: Record<string, { exerciseIds?: string[] }> }).weekly ?? {};

const chapterVisible = (chapter: string) => published.chapters.has(chapter) || isStaff;
// 節へのリンク。タイタニック演習は節ごとに公開する（53-ml-intro.md 第12節）ので、節の状態で判じる
const lessonVisible = (chapter: string, lessonId: string) => lessonIsPublic(published, chapter, lessonId) || isStaff;

function lessonLink(id: string, label?: string): WeekLink {
  const l = lessons.find((x) => x.data.id === id);
  if (!l) return { label: label ?? id, href: null };
  const siblings = lessons.filter((x) => x.data.chapter === l.data.chapter);
  const text = label ?? `${sectionLabel(l.data.chapter, siblings.indexOf(l))} ${l.data.title}`;
  return lessonVisible(l.data.chapter, l.data.id) ? { label: text, href: sectionHref(l.id) } : { label: text, href: null, note: '準備中' };
}

function shortDate(iso: string): string {
  const [, m, d] = iso.split('-').map(Number);
  return `${m}/${d}`;
}

function weeklyLink(id: string, label?: string): WeekLink {
  const w = weeklySets.find((x) => x.data.id === id);
  if (!w) return { label: label ?? id, href: null };
  const text = label ?? `今週の演習 ${shortDate(w.data.date)}（${w.data.title}）`;
  // 運営は公開する前の回も開ける（第20.4節）。メンバーには公開した回だけリンクにする（第19.4節）
  if (!openWeekly.has(id) && !isStaff) return { label: text, href: null, note: 'まだ公開していません' };
  return { label: text, href: `/learn/weekly/${encodeURIComponent(id)}/`, exIds: genWeekly[id]?.exerciseIds ?? [] };
}

// ★の段の言葉。続いた3つ以上なら「★1〜★3」、ほかは「★1・★2」「★3」（54-week-pace.md 第4.2節）
function starsLabel(levels: number[]): string {
  const lv = [...levels].sort((a, b) => a - b);
  const run = lv.every((x, i) => i === 0 || x === lv[i - 1] + 1);
  return run && lv.length >= 3 ? `★${lv[0]}〜★${lv[lv.length - 1]}` : lv.map((x) => `★${x}`).join('・');
}

// 練習問題集の行は話題ごとに1行。行き先は話題のページ、棒はその行の★の段の問題だけで数える
function practiceLinks(p: PlanPractice): WeekLink[] {
  const inChapter = practiceTopics.filter((t) => t.data.chapter === p.chapter).sort((a, b) => a.data.order - b.data.order);
  const names = p.topics ?? inChapter.map((t) => t.data.topic);
  const stars = starsLabel(p.levels);
  return names.map((name) => {
    const t = inChapter.find((x) => x.data.topic === name);
    if (!t) return { label: `練習問題集 ${name} ${stars}`, href: null };
    const label = `練習問題集 ${topicTitleText(t.data.title)} ${stars}`;
    if (!chapterVisible(p.chapter)) return { label, href: null, note: '準備中' };
    const exIds = practiceProblems(generated, t.data.id).filter((q) => p.levels.includes(q.level as 1 | 2 | 3)).map((q) => q.id);
    const href = practiceHref(p.chapter, t.data.topic);
    return exIds.length > 0 ? { label, href, exIds } : { label, href, note: 'まだ問題がありません' };
  });
}

function viewOf(row: PlanMeetRow): WeekView {
  const derived = !row.teach && !row.together ? titleHalves(row) : null;
  return {
    before: (row.before?.lessons ?? []).map((id) => lessonLink(id)),
    teachLabel: row.teach?.label ?? derived?.teach ?? '',
    teach: (row.teach?.lessons ?? []).map((id) => lessonLink(id)),
    together: derived
      ? derived.together === ''
        ? []
        : [{ label: derived.together, href: null }]
      : (row.together ?? []).map((t) => {
          if (t.lesson) return lessonLink(t.lesson, t.label);
          if (t.weekly) return weeklyLink(t.weekly, t.label);
          if (t.url) return { label: t.label ?? t.url, href: t.url, external: true };
          return { label: t.label ?? '', href: null };
        }),
    after: [...(row.after?.practice ?? []).flatMap(practiceLinks), ...(row.after?.weekly ?? []).map((id) => weeklyLink(id))],
  };
}

// 3列（前回・今回・次回。前回が無ければ今回・次回・その次）と、3列より後ろの行（休みの行も、表の順のまま）
const now = week.now;
const columns = week.columns.map((c) => ({ ...c, view: viewOf(c.row) }));
const later = week.later.map((row) => (row.kind === 'meet' ? { row, view: viewOf(row) } : { row, view: null }));
// 見出しは「今週（9/29）」（試作の案B）。複数回をまとめた行だけ「3/2〜3/30」
const nowLabel = now ? (now.until ? entranceDateLabel(now) : shortDate(now.date)) : '';

// --- 各自で進める Python の復習の帯（54-week-pace.md 第4.3節） ---
// 章の番号だけの言葉（「第3章」）。帯の「教材 第3章・第4章」のリンクの字
const chapterNo = (chapter: string) => chapterTitle(chapter).split(' ')[0];

function chapterLessonLink(chapter: string, from?: string): WeekLink {
  const first = lessons.find((x) => (from ? x.data.id === from : x.data.chapter === chapter));
  const label = chapterNo(chapter);
  if (!first) return { label, href: null };
  return lessonVisible(chapter, first.data.id) ? { label, href: sectionHref(first.id) } : { label, href: null, note: '準備中' };
}

function chapterPracticeLink(chapter: string): WeekLink {
  const label = chapterNo(chapter);
  return chapterVisible(chapter) ? { label, href: `/learn/practice/#${chapter}` } : { label, href: null, note: '準備中' };
}

const pace = member
  ? selfReviewMarks(now?.date ?? null).map(({ row, here, overdue }) => {
      // 進み具合は、見られる章の★1・★2の問題を通した割合
      const exIds = row.chapters
        .filter(chapterVisible)
        .flatMap((ch) =>
          practiceTopics
            .filter((t) => t.data.chapter === ch && (!row.topics || row.topics.includes(t.data.topic)))
            .sort((a, b) => a.data.order - b.data.order)
            .flatMap((t) => practiceProblems(generated, t.data.id).filter((q) => q.level === 1 || q.level === 2).map((q) => q.id)),
        );
      const w = row.weekly ? weeklySets.find((x) => x.data.id === row.weekly) : undefined;
      return {
        label: row.label,
        by: shortDate(row.by),
        here,
        overdue,
        exIds,
        lessons: row.chapters.map((ch) => chapterLessonLink(ch, row.from)),
        practice: row.chapters.map(chapterPracticeLink),
        weekly: row.weekly ? weeklyLink(row.weekly, w ? `今週の演習 ${shortDate(w.data.date)}` : undefined) : null,
      };
    })
  : [];
---

<Base title="今週のページ">
  {
    !member ? (
      <p class="member-deny">
        このページはプロジェクトのメンバー向けです。<a href="/learn/">教材の一覧へ</a>
      </p>
    ) : (
      <div class="wkp">
        <p class="wkp-back">
          <a href="/learn/">← 学習の一覧へ</a>
        </p>
        <h1 class="page-title">今週{nowLabel !== '' && `（${nowLabel}）`}</h1>
        <p class="wkp-lead">
          集まりの前に読んでおく節、集まりでやること、集まりのあとに解く問題を、回ごとにまとめています。
          <a href="/learn/plan/">予定をすべて見る →</a>
          <a href="/learn/project/">プロジェクトの教材へ →</a>
        </p>

        {pace.length > 0 && (
          <section class="wkp-col wkp-pace">
            <h2 class="wkp-col__h">各自で進める Python の学習</h2>
            <p class="wkp-col__no">集まりでは扱いません。目安の日までに教材を読み、練習問題集の★1・★2を解いておきます。</p>
            <ul class="wm wkp-pace__rows">
              {pace.map((p) => (
                <li class="wkp-pace__row">
                  <span class="wkp-pace__name">
                    {p.label}
                    {p.here && <span class="wkp-tag wkp-tag--now">今週</span>}
                  </span>
                  <span class={p.here ? 'wkp-pace__by is-here' : 'wkp-pace__by'}>{p.by} まで</span>
                  <span class="wkp-pace__meter">
                    {p.exIds.length > 0 ? (
                      <span class="wm-meter" data-ex-ids={p.exIds.join(' ')}>
                        <span class="wm-meter__track">
                          <span class="wm-meter__fill" data-fill style="width:0%" />
                        </span>
                        <span class="wm-meter__pct" data-pct>
                          0%
                        </span>
                        {p.overdue && <span class="wm__tag wkp-pace__left">残っています</span>}
                      </span>
                    ) : (
                      <span class="wm__tag">まだ問題がありません</span>
                    )}
                  </span>
                  <span class="wkp-pace__links">
                    教材{' '}
                    {p.lessons.map((l, i) => (
                      <>
                        {i > 0 && '・'}
                        {l.href ? <a href={l.href}>{l.label}</a> : <span class="wm__off">{l.label}</span>}
                        {l.note && <span class="wm__tag">{l.note}</span>}
                      </>
                    ))}
                    {' ／ '}練習問題集{' '}
                    {p.practice.map((l, i) => (
                      <>
                        {i > 0 && '・'}
                        {l.href ? <a href={l.href}>{l.label}</a> : <span class="wm__off">{l.label}</span>}
                        {l.note && <span class="wm__tag">{l.note}</span>}
                      </>
                    ))}
                    {p.weekly && (
                      <>
                        {' ／ '}
                        {p.weekly.href ? <a href={p.weekly.href}>{p.weekly.label}</a> : <span class="wm__off">{p.weekly.label}</span>}
                        {p.weekly.note && <span class="wm__tag">{p.weekly.note}</span>}
                      </>
                    )}
                  </span>
                </li>
              ))}
            </ul>
          </section>
        )}

        {columns.length === 0 ? (
          <p class="wkp-lead">予定の回はすべて終わりました。</p>
        ) : (
          <div class="wkp-cols">
            {columns.map((c) => (
              <section class={c.row === now ? 'wkp-col is-now' : 'wkp-col'}>
                <h2 class="wkp-col__h">
                  {entranceDateLabel(c.row)}
                  <span class={c.row === now ? 'wkp-tag wkp-tag--now' : 'wkp-tag'}>{c.tag}</span>
                  {c.row.online && <span class="wkp-tag">オンライン</span>}
                </h2>
                <p class="wkp-col__no">
                  第{c.row.no}回{c.row.goal !== '' && <span class={c.row.big ? 'wkp-goal wkp-goal--big' : 'wkp-goal'}>{c.row.goal}</span>}
                </p>
                <WeekMeeting view={c.view} />
              </section>
            ))}
          </div>
        )}

        {later.length > 0 && (
          <div class="wkp-later">
            <h2 class="wkp-later__h">その先の回</h2>
            {later.map((l) =>
              l.row.kind === 'off' ? (
                <div class="wkp-off">
                  <span class="wkp-off__d">{l.row.dateLabel ?? shortDate(l.row.date)}</span>
                  <span class="wkp-off__t">{l.row.title}</span>
                </div>
              ) : (
                <details class="wkp-row">
                  <summary>
                    <span class="wkp-row__tw" aria-hidden="true">
                      ▶
                    </span>
                    <span class="wkp-row__d">{entranceDateLabel(l.row)}</span>
                    <span class="wkp-row__t">
                      {l.row.title}
                      {l.row.online && <span class="wkp-tag">オンライン</span>}
                    </span>
                  </summary>
                  <div class="wkp-row__body">{l.view && <WeekMeeting view={l.view} />}</div>
                </details>
              ),
            )}
          </div>
        )}
      </div>
    )
  }

  <script>
    import { paintPracticeProgress } from '../../lesson/practice-progress';
    if (document.querySelector('[data-ex-ids]')) {
      void paintPracticeProgress();
      window.addEventListener('kit:account', () => void paintPracticeProgress());
    }
  </script>

  <style>
    .wkp {
      color: var(--l-ink);
      font-family: var(--font-body);
      font-size: 15px;
      line-height: 1.75;
    }
    .wkp-back {
      margin: 0 0 10px;
      font-size: 13px;
    }
    .wkp-back a,
    .wkp-lead a {
      color: var(--l-ink-2);
      text-underline-offset: 3px;
    }
    .wkp-back a:hover,
    .wkp-lead a:hover {
      color: var(--l-shu);
    }
    .wkp-lead {
      margin: 10px 0 20px;
      max-width: 70ch;
      color: var(--l-ink-2);
    }
    .wkp-lead a {
      margin-left: 6px;
      white-space: nowrap;
    }

    /* --- 3列（試作の案B）。今回の列に朱の枠 --- */
    .wkp-cols {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 12px;
      align-items: start;
    }
    .wkp-col {
      background: var(--l-card);
      border: 1px solid var(--l-rule);
      padding: 12px 14px 14px;
      min-width: 0;
    }
    .wkp-col.is-now {
      border: 2px solid var(--l-shu);
      padding: 11px 13px 13px;
    }
    .wkp-col__h {
      margin: 0;
      font-family: var(--font-head);
      font-size: 17px;
      font-weight: 700;
    }
    .wkp-col__no {
      margin: 0 0 8px;
      font-size: 12.5px;
      color: var(--l-ink-2);
    }
    .wkp-goal {
      margin-left: 8px;
    }
    .wkp-goal--big {
      color: var(--l-ink);
      font-weight: 700;
    }
    .wkp-tag {
      display: inline-block;
      margin-left: 8px;
      font-family: var(--font-body);
      font-size: 11px;
      font-weight: 400;
      border: 1px solid var(--l-rule);
      border-radius: 3px;
      padding: 0 5px;
      color: var(--l-ink-2);
      white-space: nowrap;
      vertical-align: middle;
    }
    .wkp-tag--now {
      color: var(--l-shu);
      border-color: var(--l-shu);
      font-weight: 700;
    }

    /* --- 各自で進める復習の帯（54-week-pace.md 第4.3節）。枠は今回でない列と同じ。棒と札は WeekMeeting の .wm-meter .wm__tag --- */
    .wkp-pace {
      margin-bottom: 12px;
    }
    .wkp-pace__rows {
      display: grid;
      grid-template-columns: max-content max-content max-content minmax(0, 1fr);
      gap: 2px 14px;
      margin: 0;
      padding: 0;
      list-style: none;
    }
    .wkp-pace__row {
      display: grid;
      grid-column: 1 / -1;
      grid-template-columns: subgrid;
      align-items: baseline;
    }
    .wkp-pace__by {
      color: var(--l-ink-2);
      font-variant-numeric: tabular-nums;
      white-space: nowrap;
    }
    .wkp-pace .wm-meter {
      margin-left: 0;
    }
    /* 全部通したら「残っています」は出さない（is-done は practice-progress.ts が付ける） */
    .wm-meter.is-done .wkp-pace__left {
      display: none;
    }
    .wkp-pace__links {
      min-width: 0;
    }
    .wkp-pace__links a {
      color: var(--l-ai);
      text-underline-offset: 3px;
    }
    .wkp-pace__links a:hover {
      color: var(--l-shu);
    }
    /* 今週の行は、目安の日を朱に（今回の列の朱と同じ色） */
    .wkp-pace__by.is-here {
      color: var(--l-shu);
    }

    /* --- その先の回（畳んだ行。開くと同じ中身） --- */
    .wkp-later {
      margin-top: 28px;
      border-bottom: 1px solid var(--l-rule);
    }
    .wkp-later__h {
      margin: 0 0 6px;
      font-family: var(--font-head);
      font-size: 17px;
    }
    .wkp-row {
      border-top: 1px solid var(--l-rule);
    }
    .wkp-row summary {
      display: grid;
      grid-template-columns: 1.1em 6.6em minmax(0, 1fr);
      gap: 8px;
      align-items: baseline;
      padding: 8px 4px;
      cursor: pointer;
      list-style: none;
      font-size: 14px;
    }
    .wkp-row summary::-webkit-details-marker {
      display: none;
    }
    .wkp-row summary:hover {
      background: var(--l-lv1);
    }
    .wkp-row__tw {
      font-size: 11px;
      color: var(--l-ink-2);
      transition: transform 160ms var(--ease-out);
    }
    .wkp-row[open] .wkp-row__tw {
      transform: rotate(90deg);
    }
    .wkp-row__d {
      color: var(--l-ink-2);
      font-variant-numeric: tabular-nums;
      white-space: nowrap;
    }
    .wkp-row__body {
      padding: 4px 8px 14px calc(1.1em + 8px + 4px);
      max-width: 640px;
    }
    /* 休み（祝日・冬休み・試験）は細い灰色の行（今後の予定の表と同じ。第21.2節） */
    .wkp-off {
      display: grid;
      grid-template-columns: 1.1em 6.6em minmax(0, 1fr);
      gap: 8px;
      padding: 4px 4px;
      border-top: 1px solid var(--l-rule);
      font-size: 13px;
      color: var(--l-ink-2);
    }
    .wkp-off__d {
      grid-column: 2;
      font-variant-numeric: tabular-nums;
    }

    @media (max-width: 760px) {
      .wkp-cols {
        grid-template-columns: 1fr;
      }
      .wkp-row summary,
      .wkp-off {
        grid-template-columns: 1.1em minmax(0, 1fr);
      }
      .wkp-row__d,
      .wkp-off__d,
      .wkp-off__t,
      .wkp-row__t {
        grid-column: 2;
      }
      .wkp-row__body {
        padding-left: 8px;
      }
      /* 帯は2段: 名前・目安の日・棒（右） → 行き先 */
      .wkp-pace__rows {
        display: block;
      }
      /* 棒は1段目の右へ。入りきらないときは、棒だけ次の段へ折り返す */
      .wkp-pace__row {
        display: flex;
        flex-wrap: wrap;
        gap: 2px 10px;
        padding: 6px 0;
      }
      .wkp-pace__meter {
        margin-left: auto;
      }
      .wkp-pace__row + .wkp-pace__row {
        border-top: 1px solid var(--l-rule);
      }
      .wkp-pace__links {
        flex-basis: 100%;
      }
    }
  </style>
</Base>
