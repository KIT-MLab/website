---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { chapterTitle, lessonHref, practiceSectionLabel } from '../../lesson/chapters';

const lessons = (await getCollection('lessons')).sort((a, b) => a.id.localeCompare(b.id));
const chapters = [...new Set(lessons.map((l) => l.data.chapter))];
---

<Base title="学習">
  {/* メンバーの画面への入口（20-platform.md 第13.2節）。メンバーにだけ、下の script が出す */}
  <p class="member-band" hidden><a href="/learn/home/">マイページへ →</a></p>
  <h1 class="page-title">学習</h1>
  <section>
    <p class="lead">
      機械学習を初めて学ぶ人のための教材です。Python を書くところから始め、
      ニューラルネットワークの学習と評価まで進みます。コードはこのページの中で動かせます。
    </p>
    {
      chapters.map((ch) => (
        <div class="lesson-chapter">
          <h3>{chapterTitle(ch)}</h3>
          {/* 練習編は節を「練習1-2」と呼ぶ（20-platform.md 第15.1節）。番号を振るのは呼び方の側なので、
              リストの 1. 2. は消す */}
          <ol class={practiceSectionLabel(ch, 1) ? "is-practice" : undefined}>
            {lessons
              .filter((l) => l.data.chapter === ch)
              .map((l, i) => (
                <li>
                  <a href={lessonHref(l.id)}>{[practiceSectionLabel(ch, i + 1), l.data.title].filter(Boolean).join(' ')}</a>
                  <span class="lesson-minutes">目安 {l.data.minutes} 分</span>
                </li>
              ))}
          </ol>
        </div>
      ))
    }
    <p class="learning-note">
      作っている途中です。<a href="/learn/glossary/">用語集</a>と<a href="/learn/sandbox/">実験ページ</a>も見られます。
    </p>
  </section>
</Base>

<script>
  /* このページは事前生成なので、メンバーかどうかは /api/me の答えで見る（第13.2節） */
  void fetch('/api/me')
    .then((res) => res.json())
    .then((data: { user?: { member?: boolean } | null }) => {
      const band = document.querySelector<HTMLElement>('.member-band');
      if (band && data?.user?.member === true) band.hidden = false;
    })
    .catch(() => {});

  /* 右上からログイン・ログアウトしたときも塗り直す。ログインの応答には member が無く、
     直後の /api/me の答えで塗り直されたときに member が届く（account.ts の pull） */
  window.addEventListener('kit:account', (e) => {
    const user = (e as CustomEvent<{ member?: boolean } | null>).detail;
    const band = document.querySelector<HTMLElement>('.member-band');
    if (band) band.hidden = user?.member !== true;
  });
</script>

<style>
  .member-band {
    margin: 0 0 var(--space-md);
    padding: 3px 12px;
    font-size: 14px;
    background: var(--color-card);
    border: 1.5px solid var(--color-line);
    border-radius: var(--radius);
  }
  .member-band a { color: var(--color-ink); font-weight: 700; text-underline-offset: 4px; }
  .lead { margin: 20px 0 28px; }
  .learning-note { font-size: 14px; color: var(--color-ink-2); margin-top: 28px; }
  .lesson-chapter { margin: 16px 0; }
  .lesson-chapter h3 { font-size: 17px; border-bottom: var(--rule-thin); padding-bottom: 6px; margin-bottom: 8px; }
  .lesson-chapter ol { padding-left: 28px; margin: 0; }
  .lesson-chapter ol.is-practice { list-style: none; }
  .lesson-chapter li { padding-bottom: 4px; }
  .lesson-chapter a { color: var(--color-ink); text-underline-offset: 4px; }
  .lesson-minutes { margin-left: 12px; font-size: 13px; color: var(--color-ink-2); }
</style>
