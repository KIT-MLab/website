---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { chapterTitle, lessonHref } from '../../lesson/chapters';

const lessons = (await getCollection('lessons')).sort((a, b) => a.id.localeCompare(b.id));
const chapters = [...new Set(lessons.map((l) => l.data.chapter))];
---

<Base title="学習">
  <h1 class="page-title">学習</h1>
  <section>
    <p class="lead">
      機械学習を初めて学ぶ人のための教材です。Python を書くところから始め、
      ニューラルネットワークの学習と評価まで進みます。コードはこのページの中で動かせます。
    </p>
    {
      chapters.map((ch) => (
        <div class="lesson-chapter">
          <h3>{chapterTitle(ch)}</h3>
          <ol>
            {lessons
              .filter((l) => l.data.chapter === ch)
              .map((l) => (
                <li>
                  <a href={lessonHref(l.id)}>{l.data.title}</a>
                  <span class="lesson-minutes">目安 {l.data.minutes} 分</span>
                </li>
              ))}
          </ol>
        </div>
      ))
    }
    <p class="learning-note">
      作っている途中です。<a href="/learn/glossary/">用語集</a>と<a href="/learn/sandbox/">実験ページ</a>も見られます。
    </p>
  </section>
</Base>

<style>
  .lead { margin: 20px 0 28px; }
  .learning-note { font-size: 14px; color: var(--color-ink-2); margin-top: 28px; }
  .lesson-chapter { margin: 16px 0; }
  .lesson-chapter h3 { font-size: 17px; border-bottom: var(--rule-thin); padding-bottom: 6px; margin-bottom: 8px; }
  .lesson-chapter ol { padding-left: 28px; margin: 0; }
  .lesson-chapter li { padding-bottom: 4px; }
  .lesson-chapter a { color: var(--color-ink); text-underline-offset: 4px; }
  .lesson-minutes { margin-left: 12px; font-size: 13px; color: var(--color-ink-2); }
</style>
