---
/**
 * 「今週の演習」の問題のページ（20-platform.md 第19.4節）。
 *
 * `/learn/weekly/<weeklyのid>/`。サーバ側で組み立てる（`prerender = false`）。
 * **メンバーで、自分の所属がこの回を公開していないと、中身を1文字も送らない**
 * （第13.2節と同じ考え方）。見た目は節のページと同じ組みを使うが、この回だけの
 * 1ページなので、節のページの左の欄（同じ章の他の節への行き来）と用語検索の欄は
 * 持たない（決めるのはこちらに一任されている。第18章の指示）。
 *
 * 採点は節のページと同じ部品（<Exercise>）をそのまま使う。判定データは
 * src/generated/lesson-data.json の `weekly` を埋め込む。
 */
export const prerender = false;

import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import WeeklyExercise from '../../../components/lesson/WeeklyExercise.astro';
import Input from '../../../components/lesson/Input.astro';
import Output from '../../../components/lesson/Output.astro';
import NotesPanel from '../../../components/lesson/NotesPanel.astro';
import SyntaxPanel from '../../../components/lesson/SyntaxPanel.astro';
import LiveProgress from '../../../components/lesson/LiveProgress.astro';
import TermPanel from '../../../components/lesson/TermPanel.astro';
import { lessonHref } from '../../../lesson/chapters';
import { currentUser, serverConfig } from '../../../server/auth';
import { isMember } from '../../../server/member';
import { isWeeklyOpen } from '../../../server/weekly';
import { notesForWeekly } from '../../../server/lessons-publish';
import { syntaxCategoriesFor } from '../../../lesson/weekly-syntax';
import generated from '../../../generated/lesson-data.json';
import '../../../styles/lesson.css';

const weeklyId = Astro.params.id ?? '';

const config = serverConfig();
const user = config ? await currentUser(Astro.request) : null;
const member = user !== null && isMember(user);
const isStaff = user !== null && (user.role === 'staff' || user.role === 'admin');

const entry = member ? (await getCollection('weekly')).find((e) => e.data.id === weeklyId) : undefined;
const open = member && entry && config ? await isWeeklyOpen(config.db, user!.cohort.code, entry.data.id) : false;

// 運営・管理者は、公開する前の回も中身まで見て解ける（20-platform.md 第20.4節）
const showContent = member && entry !== undefined && (open || isStaff);

Astro.response.headers.set('cache-control', 'no-store');

const genWeekly = (generated as { weekly?: Record<string, unknown> }).weekly ?? {};
const lessonData = showContent && entry ? (genWeekly[entry.data.id] ?? null) : null;
const dataJson = JSON.stringify(lessonData).replace(/</g, '\\u003c');

const Content = showContent && entry ? (await render(entry)).Content : null;

// 気づいたことのメモ（第20.3節）。運営にだけ問い合わせ、運営にだけ埋め込む
const notes = isStaff && entry && config ? await notesForWeekly(config.db, entry.data.id) : [];

// 構文の一覧（第22.1節）。この回の chapters の最後の章までに絞る。空の分類は隠す
const syntaxCategories = showContent && entry ? await syntaxCategoriesFor(entry.data.chapters) : [];

// 用語を検索（第18章。2026-09-29）。「まだ先」の判定は、この回の最後の章の最後の節まで習ったものとして行う
const lastChapter = entry?.data.chapters[entry.data.chapters.length - 1] ?? '';
const lastLesson = showContent
  ? (await getCollection('lessons')).filter((l) => l.data.chapter === lastChapter).sort((a, b) => a.id.localeCompare(b.id)).pop()
  : undefined;
const termHref = lastLesson ? lessonHref(lastLesson.id) : '';
---

<Base title={showContent && entry ? entry.data.title : '今週の演習'} bar>
  {
    /* 用語を検索（20-platform.md 第18章。2026-09-29 に今週の演習にも置いた）。幅1280px未満だけ帯のボタンで開く */
    showContent && (
      <button
        type="button"
        class="site-btn site-btn--small"
        id="kit-term-toggle"
        slot="topbar-extra"
        aria-expanded="false"
        aria-controls="kit-term-panel"
      >
        用語を検索
      </button>
    )
  }
  <div class="lesson-page wk-page">
    {
      !member ? (
        <p class="wk-notice">
          このページはプロジェクトのメンバー向けです。<a href="/learn/">学習の一覧へ</a>
        </p>
      ) : entry === undefined ? (
        <p class="wk-notice">見つかりません。</p>
      ) : !showContent ? (
        <p class="wk-notice">
          この回はまだ公開されていません。集まりのときに運営が公開します。<a href="/learn/">学習の一覧へ</a>
        </p>
      ) : (
        <>
          {isStaff && !open && (
            <p class="wk-staffnote">運営だけに見えています。まだ公開していません。</p>
          )}
          <div class="wk-grid">
            <div class="wk-grid__main">
              <div class="lesson-top">
                <p class="lesson-top__chapter">今週の演習</p>
                <h1 class="lesson-title">{entry.data.title}</h1>
                <p class="lesson-top__meta">{entry.data.date} ・ 教材の進み具合（百分率）には数えません</p>
              </div>
              {/* みんなの進み具合（53-ml-intro.md 第11節）。運営として見ているときだけ描く */}
              {isStaff && <LiveProgress weekly={entry.data.id} />}
              <article class="lesson-body">
                {Content && <Content components={{ Exercise: WeeklyExercise, Input, Output }} />}
                <nav class="lesson-nav" aria-label="ページの移動">
                  <a href="/learn/week/">← 今週のページへ</a>
                  <a href="/learn/">学習の一覧へ →</a>
                </nav>
              </article>
            </div>
            {/* 右の欄: 用語を検索（幅1280px以上だけここ。狭い画面は帯のボタンで開く重なり）と構文の一覧 */}
            <div class="wk-side">
              <TermPanel terms={[]} currentHref={termHref} ask={false} inline />
              {syntaxCategories.length > 0 && <SyntaxPanel categories={syntaxCategories} />}
            </div>
          </div>
          {isStaff && (
            <NotesPanel label="気づいたことを書く（運営だけに見えます）" weeklyId={entry.data.id} notes={notes} />
          )}
        </>
      )
    }
  </div>

  <script type="application/json" id="kit-lesson-data" set:html={dataJson} is:inline />

  <script>
    import { getLessonData } from '../../../lesson/data';
    import { getProgressStore } from '../../../lesson/store/progress';
    import { trackActivity } from '../../../lesson/activity';

    /* 提出はグレードしたらすぐ送る（20-platform.md 第19.5節。ふだんの30秒ごとを待たない）。
       運営の表がその場の様子を映すため。kit:submitted は採点1回ごと（通っても落ちても）に ExerciseBox が出す
       （src/lesson/ui/ExerciseBox.tsx）。前は通ったときだけ出る kit:progress で送っていたので、落ちた提出は
       30秒後の送信まで届かなかった（2026-09-29 に直した） */
    const data = getLessonData();
    if (data) {
      const store = getProgressStore();
      window.addEventListener('kit:submitted', () => void store.flush());

      /* 活動した分（20-platform.md 第13.6節・design/spec/55-stumbles.md 第3.2節）。記録に添える id は今週の演習の id。
         このページは進度を30秒ごとには送らないので、活動した分だけを節の画面と同じ時機
         （30秒ごと・裏に回ったとき・pagehide）で送る。入っているかどうかは節の画面と同じく手元の控えの owner で判じる */
      const activity = trackActivity(data.lessonId, async () => (await store.owner()) !== null);
      const sendActivity = () => void activity.send();
      window.setInterval(sendActivity, 30000);
      document.addEventListener('visibilitychange', () => {
        if (document.hidden) sendActivity();
      });
      window.addEventListener('pagehide', sendActivity);
    }
  </script>

  <style is:global>
    main.wrap {
      max-width: none;
      margin: 0;
      padding: calc(51px + var(--kit-band-h, 0px) + 30px) 32px 120px;
    }

    @media (max-width: 860px) {
      main.wrap {
        padding: calc(51px + var(--kit-band-h, 0px)) 16px 120px;
      }
    }

    body {
      background: var(--l-paper);
    }
  </style>

  <style>
    /* .lesson-page（lesson.css）の max-width: 720px を広げる。本文の列は右の欄（構文の一覧）の
       手前まで使う（20-platform.md 第23.3節。入力｜出力・入力例｜出力例を左右に並べるため）。
       1240 は試作の案Aの幅。欄は 272px（用語を検索の欄と同じ幅。第18.1節） */
    .wk-page {
      margin: 0 auto;
      max-width: 1240px;
    }

    /* 構文の一覧（20-platform.md 第22.1節）。幅1280px以上は2カラム（本文＋欄272px）。
       それより狭い画面は縦に並べ、欄は問題の下に回る（drawer にはしない） */
    .wk-grid {
      display: block;
    }

    /* 節のページの本文は720px のまま（第23.3節）。ここだけ lesson.css の上限を外す */
    .wk-grid__main,
    .wk-grid__main :global(.lesson-body) {
      max-width: none;
    }

    @media (min-width: 1024px) {
      .wk-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 272px;
        gap: 28px;
        align-items: start;
      }
    }

    .wk-notice {
      max-width: 60ch;
      font-family: var(--font-body);
      font-size: 16px;
      line-height: 1.9;
    }

    .wk-notice a {
      color: var(--l-ai);
      margin-left: 4px;
    }

    /* 運営だけに見えている未公開の回（20-platform.md 第20.4節） */
    .wk-staffnote {
      margin: 0 0 16px;
      padding: 6px 10px;
      font-size: 12.5px;
      line-height: 1.6;
      color: var(--l-kohaku);
      background: var(--l-card);
      border: 1px solid var(--l-kohaku);
    }
  </style>
</Base>
