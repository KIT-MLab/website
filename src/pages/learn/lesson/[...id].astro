---
/**
 * 節の画面（10-lesson-and-writing.md 第9章）。
 *
 * ・本文は1カラム最大720px、右レール240px
 * ・コード例と演習は本文中のその場で実行・採点する。別画面に飛ばさない
 * ・右レールは章の中の位置を示す。章をまたぐ移動はここからはしない
 */
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Run from '../../../components/lesson/Run.astro';
import Mistake from '../../../components/lesson/Mistake.astro';
import Exercise from '../../../components/lesson/Exercise.astro';
import Level0 from '../../../components/lesson/Level0.astro';
import { chapterTitle, lessonHref } from '../../../lesson/chapters';
import generated from '../../../generated/lesson-data.json';
import '../../../styles/lesson.css';

export async function getStaticPaths() {
  const lessons = await getCollection('lessons');
  const sorted = [...lessons].sort((a, b) => a.id.localeCompare(b.id));
  return sorted.map((entry) => {
    const siblings = sorted.filter((l) => l.data.chapter === entry.data.chapter);
    const at = siblings.findIndex((l) => l.id === entry.id);
    return {
      params: { id: entry.id },
      props: { entry, siblings, at },
    };
  });
}

type Props = {
  entry: CollectionEntry<'lessons'>;
  siblings: CollectionEntry<'lessons'>[];
  at: number;
};

const { entry, siblings, at } = Astro.props;
const { Content } = await render(entry);

const lessonData = (generated as { lessons: Record<string, unknown> }).lessons[entry.data.id] ?? null;
// </script> が本文に混ざっても JSON の埋め込みが切れないようにする
const dataJson = JSON.stringify(lessonData).replace(/</g, '\\u003c');

const prev = at > 0 ? siblings[at - 1] : null;
const next = at < siblings.length - 1 ? siblings[at + 1] : null;
---

<Base title={entry.data.title}>
  <div class="lesson-top">
    <p class="lesson-top__chapter">{chapterTitle(entry.data.chapter)}</p>
    <h1 class="lesson-title">{entry.data.title}</h1>
    <p class="lesson-top__meta">
      この章の {at + 1} / {siblings.length} 節 ・ 目安 {entry.data.minutes} 分
    </p>
  </div>

  <div class="lesson-grid">
    <article class="lesson-body">
      <Content components={{ Run, Mistake, Exercise, Level0 }} />

      <nav class="lesson-nav" aria-label="節の移動">
        {prev ? <a href={lessonHref(prev.id)}>← 前の節へ　{prev.data.title}</a> : <span class="lesson-nav__spacer" />}
        {next ? <a href={lessonHref(next.id)}>次の節へ　{next.data.title} →</a> : <span class="lesson-nav__spacer" />}
      </nav>
    </article>

    <aside class="lesson-rail">
      <div class="rail__block">
        <p class="rail__label">この章の節</p>
        <ol class="rail__list">
          {siblings.map((s) => (
            <li data-lesson-id={s.data.id} class={s.id === entry.id ? 'is-now' : ''}>
              <span class="rail__state">{s.id === entry.id ? 'いま' : '未'}</span>
              <a href={lessonHref(s.id)}>{s.data.title}</a>
            </li>
          ))}
        </ol>
      </div>

      <div class="rail__block">
        <p class="rail__label">用語集</p>
        <a class="rail__link" href="/learn/glossary/">この教材で使う言葉</a>
      </div>

      <div class="rail__block">
        <p class="rail__label">先生に聞く</p>
        <button class="rail__ask" type="button" disabled>準備中</button>
        <p class="rail__note">ログインを作ったら使えるようになります。</p>
      </div>
    </aside>
  </div>

  <script type="application/json" id="kit-lesson-data" set:html={dataJson} is:inline />

  <script>
    import { getLessonData } from '../../../lesson/data';
    import { getProgressStore } from '../../../lesson/store/progress';

    const data = getLessonData();
    const store = getProgressStore();
    if (data) void store.openLesson(data.lessonId);

    const items = Array.from(document.querySelectorAll<HTMLLIElement>('.rail__list li[data-lesson-id]'));

    async function paint() {
      const ids = items.map((el) => el.dataset.lessonId ?? '');
      const states = await store.lessonStates(ids);
      for (const el of items) {
        const mark = el.querySelector('.rail__state');
        if (!mark) continue;
        const done = states[el.dataset.lessonId ?? ''] === 'done';
        el.classList.toggle('is-done', done && !el.classList.contains('is-now'));
        if (!el.classList.contains('is-now')) mark.textContent = done ? '済' : '未';
      }
    }

    void paint();
    window.addEventListener('kit:progress', () => void paint());
  </script>

  <style is:global>
    /* 本文720px + 右レール240px が収まる幅にする */
    main.wrap {
      max-width: 1080px;
    }
  </style>
</Base>
