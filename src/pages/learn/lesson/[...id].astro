---
/**
 * 節の画面（10-lesson-and-writing.md 第9章）。
 *
 * ・本文は1カラム最大720px。上に細い帯、左に節の欄を固定する（20-platform.md 第14.2節）
 * ・コード例と演習は本文中のその場で実行・採点する。別画面に飛ばさない
 * ・左の欄は章の中の位置を示す。章をまたぐ移動はここからはしない
 */
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Run from '../../../components/lesson/Run.astro';
import Mistake from '../../../components/lesson/Mistake.astro';
import Exercise from '../../../components/lesson/Exercise.astro';
import Level0 from '../../../components/lesson/Level0.astro';
import Figure from '../../../components/lesson/Figure.astro';
import Keys from '../../../components/lesson/Keys.astro';
import Secant from '../../../components/lesson/Secant.astro';
import TermPanel from '../../../components/lesson/TermPanel.astro';
import { chapterTitle, lessonHref, practiceSectionLabel } from '../../../lesson/chapters';
import generated from '../../../generated/lesson-data.json';
import '../../../styles/lesson.css';

export async function getStaticPaths() {
  const lessons = await getCollection('lessons');
  const sorted = [...lessons].sort((a, b) => a.id.localeCompare(b.id));
  return sorted.map((entry) => {
    const siblings = sorted.filter((l) => l.data.chapter === entry.data.chapter);
    const at = siblings.findIndex((l) => l.id === entry.id);
    return {
      params: { id: entry.id },
      props: { entry, siblings, at },
    };
  });
}

type Props = {
  entry: CollectionEntry<'lessons'>;
  siblings: CollectionEntry<'lessons'>[];
  at: number;
};

const { entry, siblings, at } = Astro.props;
const { Content } = await render(entry);

const lessonData = (generated as { lessons: Record<string, unknown> }).lessons[entry.data.id] ?? null;
// </script> が本文に混ざっても JSON の埋め込みが切れないようにする
const dataJson = JSON.stringify(lessonData).replace(/</g, '\\u003c');

const prev = at > 0 ? siblings[at - 1] : null;
const next = at < siblings.length - 1 ? siblings[at + 1] : null;

/* 第0章は課題を1問ずつ出す（20-platform.md 第11.7節）。
   目印を1つ置くだけで、本文の書き方は変えない。第1章以降は属性が付かないので
   CSS も JS も当たらず、縦に並んだままになる。 */
const oneAtATime = entry.data.chapter === '00-start' ? '' : undefined;

/* 練習編（20-platform.md 第15.1節）。章は「練習編1」、節は「練習1-2」と呼ぶ。
   章の番号と節の番号（◯.◯）は付けない。ほかの章では null で、見え方は変わらない */
const practiceLabel = (n: number) => practiceSectionLabel(entry.data.chapter, n);
const isPractice = practiceLabel(1) !== null;
---

<Base title={entry.data.title} bar>
  {/* 幅1280px未満だけ表示。押すと右の用語検索の欄が右から重なって開く（第18.1節） */}
  <button
    type="button"
    class="site-btn site-btn--small"
    id="kit-term-toggle"
    slot="topbar-extra"
    aria-expanded="false"
    aria-controls="kit-term-panel"
  >
    用語を検索
  </button>

  <div class="lesson-page">
    {/* 左の欄（第14.2節）。広い画面では帯の下に固定し、中身が長ければ欄の中だけでスクロールする。
        幅860px以下では、帯のすぐ下に固定した1行のボタンに畳む */}
    <aside class="lesson-rail" id="kit-side">
      <button class="rail__toggle" type="button" aria-expanded="false" aria-controls="kit-side-in">
        <span>{isPractice ? 'この練習編の節' : 'この章の節'}（{at + 1} / {siblings.length}）</span>
        <span data-side-word>開く</span>
      </button>
      <div class="rail__in" id="kit-side-in">
        <div class="rail__block">
          <p class="rail__label">{chapterTitle(entry.data.chapter)}</p>
          <ol class="rail__list">
            {siblings.map((s, i) => (
              <li data-lesson-id={s.data.id} class={s.id === entry.id ? 'is-now' : ''}>
                <span class="rail__state">{s.id === entry.id ? 'いま' : '未'}</span>
                <a href={lessonHref(s.id)}>{isPractice ? `${practiceLabel(i + 1)} ${s.data.title}` : s.data.title}</a>
              </li>
            ))}
          </ol>
        </div>

      </div>
    </aside>

    <div class="lesson-top">
      <p class="lesson-top__chapter">{chapterTitle(entry.data.chapter)}</p>
      <h1 class="lesson-title">{entry.data.title}</h1>
      <p class="lesson-top__meta">
        {isPractice
          ? `${practiceLabel(at + 1)} ・ この練習編の ${at + 1} / ${siblings.length} 節`
          : `この章の ${at + 1} / ${siblings.length} 節`} ・ 目安 {entry.data.minutes} 分
      </p>
    </div>

    <article class="lesson-body" data-exq={oneAtATime}>
      <Content components={{ Run, Mistake, Exercise, Level0, Keys, Figure, Secant }} />

      <nav class="lesson-nav" aria-label="節の移動">
        {prev ? <a href={lessonHref(prev.id)}>← 前の節へ　{prev.data.title}</a> : <span class="lesson-nav__spacer" />}
        {next ? <a href={lessonHref(next.id)}>次の節へ　{next.data.title} →</a> : <span class="lesson-nav__spacer" />}
      </nav>
    </article>
  </div>

  <TermPanel terms={entry.data.terms} currentHref={lessonHref(entry.id)} />

  <script type="application/json" id="kit-lesson-data" set:html={dataJson} is:inline />

  <script>
    import { getLessonData } from '../../../lesson/data';
    import { getProgressStore } from '../../../lesson/store/progress';
    import { setupExerciseQueue } from '../../../lesson/exercise-queue';
    import { trackActivity } from '../../../lesson/activity';

    const data = getLessonData();
    const store = getProgressStore();
    if (data) void store.openLesson(data.lessonId);

    /* 活動した分（20-platform.md 第13.6節）。送るのは下の send() と同じ時機。
       入っているかどうかは進度の送信（store.flush）と同じく手元の控えの owner で判じる */
    const activity = data ? trackActivity(data.lessonId, async () => (await store.owner()) !== null) : null;

    // 第0章だけ、課題を1問ずつ出す（第11.7節）。ほかの章では何もせずに戻る
    setupExerciseQueue();

    // 狭い画面で左の欄を畳む1行のボタン（第14.2節）。広い画面ではボタンごと隠れている
    const side = document.getElementById('kit-side');
    const sideToggle = side?.querySelector<HTMLButtonElement>('.rail__toggle');
    sideToggle?.addEventListener('click', () => {
      const open = side!.classList.toggle('is-open');
      sideToggle.setAttribute('aria-expanded', String(open));
      const word = sideToggle.querySelector('[data-side-word]');
      if (word) word.textContent = open ? '閉じる' : '開く';
    });

    const items = Array.from(document.querySelectorAll<HTMLLIElement>('.rail__list li[data-lesson-id]'));

    async function paint() {
      const ids = items.map((el) => el.dataset.lessonId ?? '');
      const states = await store.lessonStates(ids);
      for (const el of items) {
        const mark = el.querySelector('.rail__state');
        if (!mark) continue;
        const done = states[el.dataset.lessonId ?? ''] === 'done';
        el.classList.toggle('is-done', done && !el.classList.contains('is-now'));
        if (!el.classList.contains('is-now')) mark.textContent = done ? '済' : '未';
      }
    }

    void paint();
    window.addEventListener('kit:progress', () => void paint());

    /* 進度をサーバへ送る（20-platform.md 第6.2節「送る間隔」・第7章）。

       送るのは**30秒ごとと、節を離れるとき**だけである。1操作ごとには送らない。
       採点のたびに送ると、勉強会で30人が一斉に解いている間ずっと書き込みが走る。
       入っていない人は store.flush() が何もせずに true を返すので、この仕掛けは
       そのまま置いておける（判断を2か所に持たない）。

       滞在の秒数は**画面が見えている間だけ**数える。裏に回っているタブや、別の
       アプリの後ろに隠れている時間を足すと、読んでいない時間まで滞在になる。

       離れたことは visibilitychange（hidden）と pagehide の両方で拾う。閉じるときに
       visibilitychange が鳴らない環境があり、pagehide だけの環境でタブを切り替えると
       鳴らないため、片方では足りない。 */
    const SEND_EVERY_MS = 30000;
    /** 見えている状態が続いている区間の始まり。裏に回っている間は null */
    let watching: number | null = document.visibilityState === 'visible' ? Date.now() : null;

    function countSeconds() {
      if (!data || watching === null) return;
      const whole = Math.floor((Date.now() - watching) / 1000);
      if (whole <= 0) return;
      // 端数は次に持ち越す。切り捨てたぶんを捨てると、30秒ごとに1秒弱ずつ目減りする
      watching += whole * 1000;
      void store.addSeconds(data.lessonId, whole);
    }

    function send() {
      countSeconds();
      void store.flush();
      void activity?.send();
    }

    window.setInterval(send, SEND_EVERY_MS);

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        send();
        watching = null;
      } else {
        watching = Date.now();
      }
    });

    window.addEventListener('pagehide', send);

    /* 課題が1問も無い節を終わりにする（10-lesson-and-writing.md 第3.8節）。
       通す相手がいないので、ExerciseBox の「全部通したら done」が一度も走らない。

       目印にするのは節の移動の帯まで読み進めたこと。「次へ」を押した時点にしないのは
       理由が2つある。章の最後の節には「次へ」が無いので永久に終われないことと、
       押した直後にページが移るので書き込みが間に合わないことがあるためである。

       IntersectionObserver は使わない。描画していない環境（画面に出ていない枠、
       縮小表示の取り込みなど）では一度も鳴らず、そのとき**黙って何も起きない**。
       進度が付かないことに誰も気づけないので、位置を自分で測る。
       短い節では読み込んだ時点で帯が見えているため、最初に1回測る。

       課題のある節では何もしない。そちらは全部通したときに立つ。 */
    if (data && document.querySelectorAll('section.kit-ex').length === 0) {
      const foot = document.querySelector('.lesson-nav');
      if (foot) {
        let marked = false;
        const check = () => {
          if (marked || foot.getBoundingClientRect().top > window.innerHeight) return;
          marked = true;
          window.removeEventListener('scroll', check);
          window.removeEventListener('resize', check);
          void store.finishLesson(data.lessonId).then(() => {
            window.dispatchEvent(new CustomEvent('kit:progress'));
          });
        };
        window.addEventListener('scroll', check, { passive: true });
        window.addEventListener('resize', check);
        check();
      }
    }
  </script>

  <style is:global>
    /* 帯（高さ48px＋二重罫3px、Base.astro の .topbar）と左の欄（232px）を避けて本文を置く（第14.2節）。
       本文の幅は .lesson-page で720pxまでに抑える */
    main.wrap {
      max-width: none;
      margin: 0 0 0 232px;
      padding: calc(51px + 30px) 32px 120px;
    }

    /* 足もとの行も左の欄の下に潜らないようにする */
    .foot {
      margin-left: 232px;
    }

    /* 節の紙は教材の決定（第10.9節）の #f6f2e9。端まで敷くため body に置く */
    body {
      background: var(--l-paper);
    }

    /* 用語を検索する右の欄（第18.1節）ぶんの余白。欄は幅1280px以上だけ常設で出る */
    @media (min-width: 1280px) {
      main.wrap {
        margin-right: 272px;
      }
    }

    @media (max-width: 860px) {
      main.wrap {
        margin: 0;
        padding: 51px 16px 120px;
      }

      .foot {
        margin-left: 0;
      }
    }
  </style>
</Base>
