---
import '../styles/tokens.css';
import '../styles/lesson-tokens.css';
import '../styles/account.css';
import AccountDialog from '../components/AccountDialog.astro';

interface Props {
  title: string;
  /** 節のページだけ、マストヘッドの代わりに細い帯を上に固定する（20-platform.md 第14.2節） */
  bar?: boolean;
}
const { title, bar = false } = Astro.props;

const NAV = [
  { href: '/', label: 'ホーム' },
  { href: '/about/', label: 'プロジェクトについて' },
  { href: '/activities/', label: '活動' },
  { href: '/learn/', label: '学習' },
  { href: '/news/', label: '成果・お知らせ' },
];

const here = Astro.url.pathname.replace(/\/?$/, '/');
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>{title} | KIT 機械学習プロジェクト</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Zen+Old+Mincho:wght@400;700;900&family=BIZ+UDPGothic:wght@400;700&family=Noto+Serif+JP:wght@400;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap"
    />
  </head>
  <body>
    {/* 右上のアカウント（第14.1節）。中身は src/lesson/account.ts が /api/me の答えを見てから塗る。
        それまでは空のまま置く（ログインしている人に「新規登録」を一瞬見せないため） */}
    {
      bar ? (
        <header class="topbar">
          <a class="topbar__name" href="/">KIT 機械学習プロジェクト</a>
          <nav class="topbar__links" aria-label="サイト内メニュー">
            {NAV.map((item) => (
              <a href={item.href} aria-current={item.href !== '/' && here.startsWith(item.href) ? 'true' : undefined}>
                {item.label}
              </a>
            ))}
          </nav>
          <div class="acct" id="kit-acct-head" />
        </header>
      ) : (
        <header class="masthead">
          <div class="acct masthead__acct" id="kit-acct-head" />
          <div class="wrap">
            <a class="masthead__name" href="/">KIT 機械学習プロジェクト</a>
            <p class="masthead__full">AI・機械学習を全課程で0から学べるプロジェクト</p>
            <nav class="masthead__links" aria-label="サイト内メニュー">
              {NAV.map((item) => (
                <a href={item.href} aria-current={here === item.href ? 'page' : undefined}>
                  {item.label}
                </a>
              ))}
            </nav>
          </div>
        </header>
      )
    }

    <main class="wrap">
      <slot />
    </main>

    <footer class="foot">
      <div class="wrap">京都工芸繊維大学 KIT 機械学習プロジェクト</div>
    </footer>

    <AccountDialog />
  </body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    background: var(--color-paper);
    color: var(--color-ink);
    font-family: var(--font-body);
    line-height: 1.9;
    -webkit-font-smoothing: antialiased;
  }

  .wrap {
    max-width: 960px;
    margin: 0 auto;
    padding: 0 var(--space-lg);
  }

  a:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 3px;
  }

  /* 押せるものはマウスを乗せたら見た目を変える（20-platform.md 第14.6節）。
     文字のリンクは地を --l-chip にする。:where で詳しさを0にしてあるので、
     自分の hover を持つ部品（ボタンの形のリンクなど）はそちらが勝つ */
  :where(a[href]):hover {
    background-color: var(--l-chip);
  }

  /* マストヘッド中央（DECISIONS.md 第1次トークン: ナビ形式） */
  .masthead {
    position: relative;
    border-bottom: var(--rule);
    padding-top: calc(22px * var(--sp));
  }

  /* 右上のアカウント（第14.1節）。見出しの組み方は変えず、右上の角に重ねるだけ */
  .masthead__acct {
    position: absolute;
    top: 12px;
    right: 18px;
    z-index: 20;
  }

  @media (max-width: 860px) {
    /* 狭い画面ではサイト名と重なるので、名前の上に右寄せで1行置く。
       /api/me の答えを待つ間も高さを取っておき、塗ったときに見出しが下にずれないようにする */
    .masthead__acct {
      position: relative;
      top: auto;
      right: auto;
      min-height: 30px;
      margin: 0 16px 6px;
    }
  }

  /* --- 節のページの帯（第14.2節。試作の案A「帯を固定」） --------- */
  .topbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 20;
    box-sizing: content-box;
    height: 48px;
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 0 18px;
    background: var(--l-paper);
    border-bottom: 3px double var(--l-strong);
  }

  .topbar__name {
    flex: 0 1 auto;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-family: var(--font-head);
    font-weight: 900;
    font-size: 16px;
    color: var(--l-ink);
    text-decoration: none;
  }

  .topbar__links {
    display: flex;
    flex-wrap: nowrap;
    gap: 14px;
    overflow: hidden;
    font-size: 13px;
  }

  .topbar__links a {
    color: var(--l-ink);
    text-decoration: none;
    white-space: nowrap;
  }

  .topbar__links a[aria-current] {
    border-bottom: 3px solid var(--color-accent);
  }

  .topbar .acct {
    flex: 0 0 auto;
    margin-left: auto;
  }

  @media (max-width: 860px) {
    .topbar {
      gap: 10px;
      padding: 0 12px;
    }

    .topbar__links {
      display: none;
    }

    /* 幅375pxでサイト名とボタン2つが1行に収まるように、ボタンの横の余白だけ詰める */
    .topbar .acct {
      gap: 6px;
    }

    .topbar .site-btn--small {
      padding-inline: 8px;
    }
  }

  .masthead__name {
    display: block;
    text-align: center;
    text-decoration: none;
    color: inherit;
    font-family: var(--font-head);
    font-weight: 700;
    font-size: clamp(1.15rem, 3.4vw, 1.5rem);
    letter-spacing: 0.08em;
    line-height: 1.4;
  }

  .masthead__full {
    margin: calc(6px * var(--sp)) 0 0;
    text-align: center;
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    color: var(--color-ink-2);
  }

  .masthead__links {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: calc(26px * var(--sp));
    margin-top: calc(14px * var(--sp));
    border-top: var(--rule-thin);
    padding: calc(10px * var(--sp)) 0;
  }

  .masthead__links a {
    text-decoration: none;
    color: inherit;
    font-size: 0.85rem;
    white-space: nowrap;
    padding-bottom: 2px;
  }

  .masthead__links a:hover {
    color: var(--color-accent);
  }

  /* 現在地の表示 = 決定済みの「アクセント色の太下線」 */
  .masthead__links a[aria-current='page'] {
    border-bottom: 4px solid var(--color-accent);
    font-weight: 700;
  }

  main {
    padding-top: var(--space-xl);
    padding-bottom: var(--space-2xl);
    min-height: 50vh;
  }

  /* セクション見出し = 決定済みの「左バー（アクセント5px）」 */
  .page-title {
    margin: 0;
    font-family: var(--font-head);
    font-weight: 700;
    font-size: clamp(1.4rem, 3.6vw, 1.9rem);
    line-height: 1.5;
    border-left: 5px solid var(--color-accent);
    padding-left: var(--space-md);
  }

  .wip {
    margin-top: var(--space-lg);
    color: var(--color-ink-2);
    font-size: 0.88rem;
  }

  .foot {
    border-top: var(--rule);
    padding: var(--space-lg) 0;
    text-align: center;
    font-size: 0.78rem;
    color: var(--color-ink-2);
  }
</style>
