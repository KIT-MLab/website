---
/**
 * 今週のページ（20-platform.md 第25.4節・design/spec/54-week-pace.md 第4.2節）の1回ぶんの中身:
 * この回の前に（予習）・この回でやること（前半・後半）・この回のあとに（復習）を時間の順に。
 * 3列の列と、その先の回を開いたときの中身の両方で使う。
 *
 * 行き先が見られない（章が準備中・今週の演習がまだ公開されていない）ものは、リンクにせず
 * 言葉だけを出して小さな札を添える（学習の一覧の鍵と同じ考え方。第20.1節・第19.4節）。
 * 進み具合の棒は `data-ex-ids` を置くだけで、ブラウザで src/lesson/practice-progress.ts が塗る。
 * 各自で進める復習の帯（src/pages/learn/week.astro）も同じ `.wm-meter` `.wm__tag` を使うので、
 * 様式は is:global にしている（名前はどれも `wm` で始まる）。
 */
import type { WeekView } from '../../lesson/plan';

interface Props {
  view: WeekView;
}
const { view } = Astro.props;
---

<div class="wm">
  <p class="wm__k">この回の前に（予習）</p>
  {
    view.before.length === 0 ? (
      <p class="wm__none">―</p>
    ) : (
      <ul class="wm__list">
        {view.before.map((l) => (
          <li>
            {l.href ? <a href={l.href}>{l.label}</a> : <span class="wm__off">{l.label}</span>}
            {l.note && <span class="wm__tag">{l.note}</span>}
          </li>
        ))}
      </ul>
    )
  }

  <p class="wm__k">この回でやること</p>
  <p class="wm__k wm__k--sub">前半（新しく学ぶ）</p>
  {view.teachLabel === '' && view.teach.length === 0 ? <p class="wm__none">―</p> : null}
  {view.teachLabel !== '' && <p class="wm__label">{view.teachLabel}</p>}
  {
    view.teach.length > 0 && (
      <ul class="wm__list">
        {view.teach.map((l) => (
          <li>
            {l.href ? <a href={l.href}>{l.label}</a> : <span class="wm__off">{l.label}</span>}
            {l.note && <span class="wm__tag">{l.note}</span>}
          </li>
        ))}
      </ul>
    )
  }

  <p class="wm__k wm__k--sub">後半（みんなで取り組む）</p>
  {
    view.together.length === 0 ? (
      <p class="wm__none">―</p>
    ) : (
      <ul class="wm__list">
        {view.together.map((l) => (
          <li>
            {l.href ? (
              <a href={l.href} {...(l.external ? { target: '_blank', rel: 'noopener' } : {})}>
                {l.label}
              </a>
            ) : (
              <span class={l.note ? 'wm__off' : ''}>{l.label}</span>
            )}
            {l.note && <span class="wm__tag">{l.note}</span>}
            {l.exIds && l.exIds.length > 0 && (
              <span class="wm-meter" data-ex-ids={l.exIds.join(' ')}>
                <span class="wm-meter__track">
                  <span class="wm-meter__fill" data-fill style="width:0%" />
                </span>
                <span class="wm-meter__pct" data-pct>
                  0%
                </span>
              </span>
            )}
          </li>
        ))}
      </ul>
    )
  }

  <p class="wm__k">この回のあとに（復習）</p>
  {
    view.after.length === 0 ? (
      <p class="wm__none">―</p>
    ) : (
      <ul class="wm__list">
        {view.after.map((l) => (
          <li>
            {l.href ? <a href={l.href}>{l.label}</a> : <span class="wm__off">{l.label}</span>}
            {l.note && <span class="wm__tag">{l.note}</span>}
            {l.exIds && l.exIds.length > 0 && (
              <span class="wm-meter" data-ex-ids={l.exIds.join(' ')}>
                <span class="wm-meter__track">
                  <span class="wm-meter__fill" data-fill style="width:0%" />
                </span>
                <span class="wm-meter__pct" data-pct>
                  0%
                </span>
              </span>
            )}
          </li>
        ))}
      </ul>
    )
  }
</div>

<style is:global>
  .wm {
    font-size: 14px;
    line-height: 1.65;
  }
  .wm__k {
    margin: 12px 0 2px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--l-ink-2);
  }
  .wm__k:first-child {
    margin-top: 0;
  }
  /* 「この回でやること」の中の前半・後半は、見出しより一段小さく（太字にしない） */
  .wm__k--sub {
    margin-top: 6px;
    font-weight: 400;
  }
  .wm__label {
    margin: 0 0 2px;
    font-weight: 700;
  }
  .wm__none {
    margin: 0;
    color: var(--l-ink-2);
  }
  .wm__list {
    margin: 0;
    padding-left: 1.1em;
  }
  .wm__list li {
    margin: 1px 0;
  }
  .wm__list a {
    color: var(--l-ai);
    text-underline-offset: 3px;
  }
  /* 押せるものは、乗せたら見た目を変える（第14.6節） */
  .wm__list a:hover {
    color: var(--l-shu);
  }
  .wm__off {
    color: var(--l-ink-2);
  }
  .wm__tag {
    display: inline-block;
    margin-left: 6px;
    font-size: 11px;
    border: 1px solid var(--l-rule);
    border-radius: 3px;
    padding: 0 5px;
    color: var(--l-ink-2);
    white-space: nowrap;
    vertical-align: 1px;
  }

  /* 進み具合の棒（学習の一覧の今週の演習の棒と同じ形。棒と百分率だけで、分数は出さない。第19.4節） */
  .wm-meter {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-left: 8px;
    font-size: 12px;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    vertical-align: middle;
  }
  .wm-meter__track {
    display: inline-block;
    width: 56px;
    height: 5px;
    background: var(--l-lv2);
    border-radius: 3px;
    overflow: hidden;
  }
  .wm-meter__fill {
    display: block;
    height: 100%;
    background: var(--l-ink-2);
    border-radius: 3px;
    transition: width 200ms var(--ease-out);
  }
  .wm-meter.is-done .wm-meter__fill {
    background: var(--l-midori);
  }
  .wm-meter__pct {
    font-weight: 700;
    color: var(--l-ink-2);
  }
  .wm-meter.is-done .wm-meter__pct {
    color: var(--l-midori);
  }
</style>
