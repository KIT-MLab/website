---
/**
 * アカウント（20-platform.md 第5.6節）。
 *
 * 右レールの「先生に聞く」の上に置く1ブロックと、本文の上にかぶせる小窓。
 * 中身の塗り替えと小窓の開け閉めは src/lesson/account.ts が受け持つ。
 *
 * ブロックの最初の中身が「確かめています。」なのは、節のページが事前生成で、
 * 組み立てる時点ではログインしているかどうかが分からないため。入っている人に
 * 「登録する」を一瞬だけ見せないように、`/api/me` の答えが来てから塗る。
 *
 * 小窓は4つの段を1つの `<dialog>` に入れ、`hidden` で出し入れする。
 * **段2（控える）と段4（この端末に残っている記録）は閉じる道を塞いである。**
 * 段2は合言葉がこの一度しか出ないため、段4は手元の記録の行き先が決まらないまま
 * 残ってしまうため（第6.1節）。どちらも × を置かず、`Esc` と背景も account.ts で止める。
 */
---

<div class="rail__block">
  <p class="rail__label">アカウント</p>
  <div class="rail__acct" id="kit-acct-rail">
    <p class="rail__note">確かめています。</p>
  </div>
</div>

<dialog class="kit-acct" id="kit-acct" aria-label="アカウント">
  <div class="kit-acct__panel">
    <!-- 段1: 登録 -->
    <section data-acct-stage="register">
      <h2 class="kit-acct__title">登録する</h2>
      <p class="kit-acct__note">
        招待コードと表示名だけで登録できます。表示名は他の学習者には見えません。先生には見えます。
      </p>
      <form id="kit-acct-reg-form" novalidate>
        <div class="kit-acct__field">
          <label class="kit-acct__lab" for="kit-acct-code">招待コード</label>
          <input
            class="kit-acct__in kit-acct__in--mono"
            id="kit-acct-code"
            type="text"
            autocapitalize="characters"
            autocomplete="off"
            autocorrect="off"
            spellcheck="false"
          />
          <p class="kit-acct__deny" data-acct-deny="code"></p>
        </div>
        <div class="kit-acct__field">
          <label class="kit-acct__lab" for="kit-acct-name">表示名</label>
          <input
            class="kit-acct__in"
            id="kit-acct-name"
            type="text"
            maxlength="40"
            autocomplete="off"
          />
          <p class="kit-acct__deny" data-acct-deny="name"></p>
        </div>
        <div class="kit-ex__bar">
          <button class="kit-btn kit-btn--strong" id="kit-acct-reg-go" type="submit">登録する</button>
          <button class="kit-btn" type="button" data-acct-cancel>やめる</button>
        </div>
      </form>
    </section>

    <!-- 段2: 控える。閉じる手は「控えました」だけ -->
    <section data-acct-stage="save" hidden>
      <h2 class="kit-acct__title">控えてください</h2>
      <p class="kit-acct__note">
        合言葉が出るのはこの一度だけです。別の端末から入るときに使いますので、紙に書き写してください。忘れたときは先生が作り直します。
      </p>
      <div class="kit-acct__field">
        <p class="kit-acct__lab">利用者ID</p>
        <p class="kit-acct__uid" id="kit-acct-made-id"></p>
      </div>
      <div class="kit-acct__field">
        <p class="kit-acct__lab">合言葉</p>
        <p class="kit-acct__pass" id="kit-acct-made-pass"></p>
      </div>
      <div class="kit-ex__bar">
        <button class="kit-btn kit-btn--strong" id="kit-acct-saved" type="button">控えました</button>
      </div>
    </section>

    <!-- 段3: 入る -->
    <section data-acct-stage="login" hidden>
      <h2 class="kit-acct__title">入る</h2>
      <p class="kit-acct__note">登録したときに控えた利用者IDと合言葉を入れてください。</p>
      <form id="kit-acct-login-form" novalidate>
        <div class="kit-acct__field">
          <label class="kit-acct__lab" for="kit-acct-uid">利用者ID</label>
          <input
            class="kit-acct__in kit-acct__in--mono"
            id="kit-acct-uid"
            type="text"
            autocapitalize="characters"
            autocomplete="off"
            autocorrect="off"
            spellcheck="false"
          />
          <p class="kit-acct__deny" data-acct-deny="uid"></p>
        </div>
        <div class="kit-acct__field">
          <label class="kit-acct__lab" for="kit-acct-pass">合言葉</label>
          <input
            class="kit-acct__in kit-acct__in--mono"
            id="kit-acct-pass"
            type="text"
            inputmode="numeric"
            autocomplete="off"
            spellcheck="false"
          />
          <p class="kit-acct__deny" data-acct-deny="pass"></p>
        </div>
        <div class="kit-ex__bar">
          <button class="kit-btn kit-btn--strong" id="kit-acct-login-go" type="submit">入る</button>
          <button class="kit-btn" type="button" data-acct-cancel>やめる</button>
        </div>
      </form>
    </section>

    <!-- 段4: この端末に残っている記録（第6.1節）。
         閉じる手は「引き継ぐ」と「捨てる」の2つだけ。中途半端に閉じられると、
         手元の記録の行き先が決まらないまま残る -->
    <section data-acct-stage="carry" hidden>
      <h2 class="kit-acct__title">この端末に残っている記録</h2>
      <p class="kit-acct__note">
        このパソコンに、入る前に進めた記録が残っています（<span id="kit-acct-carry-n">0</span>節）。
      </p>
      <p class="kit-acct__note kit-acct__ask">これはあなたの記録ですか。</p>
      <div class="kit-ex__bar">
        <button class="kit-btn kit-btn--strong" id="kit-acct-carry-yes" type="button">はい、引き継ぐ</button>
        <button class="kit-btn" id="kit-acct-carry-no" type="button">いいえ、捨てる</button>
      </div>
    </section>
  </div>
</dialog>

<script>
  import { setupAccount } from '../../lesson/account';
  setupAccount();
</script>
