---
/**
 * スライド（design/spec/53-ml-intro.md 第10節）。節の frontmatter の `slides: intro1` で本文の上の段に付く。
 * 本文の中の `<Slides deck="intro1-picto" />` は SlidesInBody.astro を通ってここに来る（2026-09-29）。
 * 1つのページに2つ以上あってよい（いまの番号はスライドごと。src/lesson/slides.ts）。
 *
 * 運営が「前へ」「次へ」を押すと、同じ所属のメンバーの画面も1〜2秒で同じ1枚に切り替わる
 * （src/lesson/slides.ts が /api/slides を読み直す）。どの幅でも本文の上の開け閉めできる段に、本文の幅いっぱいに
 * 置く（2026-09-29。前は幅1280px以上で右の欄に置いていた）。
 *
 * 中身（文字・人の図の人数）はこの HTML にだけ書く。節のページはメンバー・運営にしかこの部品を描かないので、
 * ほかの人にも、誰でも読むファイル（dist/client）にも入らない。
 *
 * 人の図は案B（横一列。2026-09-28 利用者の選択）。人の形1つが約10人、組ごとに横一列、生き残った人を左に寄せる。
 * 生き残った = 黄緑の塗り、亡くなった = 赤の線（塗らない）。色だけで分けない（塗りと線・ラベルの人数）。
 *
 * 写真・絵（kind: image）と航路の地図（kind: map。船は段と段の間を1秒で動く）は 2026-09-29 に足した。
 * 1枚ごとの note（話すこと）は、運営として見ているとき（staff）だけ描く。メンバー・学習者の HTML には入らない
 * （<Facilitate> と同じ）。
 *
 * **1枚の欄の高さはスライドごとに1つ**（2026-09-29。利用者の依頼「前へ・次へのボタンが動かないように」）。
 * src/lesson/slides.ts が全部の1枚を測り、いちばん高いものに欄（.kit-slides__view）の高さをそろえる。
 * 幅が変わったら測り直す。ボタンの段は欄のすぐ下、話すこと（運営だけ・長さが1枚ごとに違う）はボタンの下に置く。
 */
import { mapStep, pictoGroups } from '../../lesson/slides/decks.mjs';
import { LAND, MAP_H, MAP_W, POINTS } from '../../lesson/slides/north-atlantic.mjs';

type Base = { title: string; note?: string };
type Slide = Base &
  (
    | { kind: 'text'; lines: string[] }
    | { kind: 'picto'; sub?: string; by: string; reveal: boolean }
    | { kind: 'map'; lines?: string[]; step: 'southampton' | 'queenstown' | 'sink' }
    | { kind: 'image'; src: string; alt: string; credit: string }
    | { kind: 'facts'; items: { value: string; label: string }[] }
  );

interface Props {
  deckId: string;
  deck: {
    cells: { n: number; s: number }[];
    slides: Slide[];
  };
  /** 運営・管理者か（運営として見ているとき）。押すとみんなの画面が切り替わる。note（話すこと）もこのときだけ描く */
  staff: boolean;
}

const { deckId, deck, staff } = Astro.props;
const count = deck.slides.length;

/* 地図（kind: 'map'）。座標は 640×360 の図の上。港の点・名前・船は、幅が変わっても同じ大きさで読めるように
   図の上に重ねた HTML にし、位置だけ % で置く。名前の置き場所は右の欄（地図の幅約210px）で重ならないように決めた。
   side: r = 名前の右端をその点に、l = 左端をその点に。線（lead）は港の点から名前まで */
const px = (x: number) => `${Math.round((x / MAP_W) * 10000) / 100}%`;
const py = (y: number) => `${Math.round((y / MAP_H) * 10000) / 100}%`;
const PORTS = [
  { name: 'サウサンプトン', at: 'southampton', x: 498, y: 60, side: 'r' },
  { name: 'クイーンズタウン', at: 'queenstown', x: 498, y: 112, side: 'r' },
  { name: 'シェルブール', at: 'cherbourg', x: 638, y: 215, side: 'r', lead: [596, 215] },
  { name: 'ニューヨーク', at: 'newyork', x: 14, y: 285, side: 'l', lead: [22, 285] },
] as const;
const SINK_LABEL = { x: 250, y: 262 };
const hasMap = deck.slides.some((s) => s.kind === 'map');

// ブラウザのスクリプトに渡すのは人の図の組と人数、地図の船の位置と道だけ（文字の1枚は下の HTML にある）
const payload = {
  deck: deckId,
  count,
  staff,
  cells: deck.cells.map((c) => ({ n: c.n, s: c.s })),
  picto: deck.slides.map((s) =>
    s.kind === 'picto' ? { reveal: s.reveal, groups: pictoGroups(deck as never, s.by as never) } : null,
  ),
  map: deck.slides.map((s) => {
    if (s.kind !== 'map') return null;
    const m = mapStep(s.step);
    return { x: px(m.ship[0]), y: py(m.ship[1]), done: m.done, rest: m.rest, sink: m.sink };
  }),
};
const payloadJson = JSON.stringify(payload).replace(/</g, '\\u003c');

// 凡例の形（src/lesson/slides.ts の図の形と同じ）
const person = `<svg width="12" height="18" viewBox="0 0 20 30" aria-hidden="true"><circle class="kit-picto__b" cx="10" cy="6" r="4.6"/><path class="kit-picto__b" d="M3.4 28.5V17.5c0-4.1 2.9-6.6 6.6-6.6s6.6 2.5 6.6 6.6v11z"/></svg>`;
---

<section class="kit-slides" data-slides={deckId} tabindex="0" aria-label="スライド">
  <button type="button" class="kit-slides__toggle" aria-expanded="true" aria-controls={`kit-slides-in-${deckId}`}>
    <span>スライド <span data-slides-no>1 / {count}</span></span>
    <span data-slides-word>閉じる</span>
  </button>

  <div class="kit-slides__in" id={`kit-slides-in-${deckId}`}>
    <div class="kit-slides__view" aria-live="polite">
      {
        deck.slides.map((s, i) => (
          <div class="kit-slide" data-slide={i} hidden={i !== 0}>
            <p class:list={['kit-slide__title', s.kind === 'image' && 'kit-slide__title--img']}>{s.title}</p>
            {(s.kind === 'text' || s.kind === 'map') && s.lines?.map((l) => <p class="kit-slide__line">{l}</p>)}
            {s.kind === 'picto' && s.sub && <p class="kit-slide__sub">{s.sub}</p>}
            {s.kind === 'facts' && (
              <dl class="kit-facts">
                {s.items.map((it) => (
                  <div class="kit-facts__item">
                    <dt class="kit-facts__v">{it.value}</dt>
                    <dd class="kit-facts__l">{it.label}</dd>
                  </div>
                ))}
              </dl>
            )}
            {s.kind === 'image' && (
              <>
                <img class="kit-slide__img" src={s.src} alt={s.alt} decoding="async" />
                <p class="kit-slide__credit">{s.credit}</p>
              </>
            )}
          </div>
        ))
      }
      {
        hasMap && (
          <div class="kit-map" data-map hidden>
            <svg class="kit-map__svg" viewBox={`0 0 ${MAP_W} ${MAP_H}`} aria-hidden="true">
              <rect class="kit-map__sea" width={MAP_W} height={MAP_H} />
              <path class="kit-map__land" d={LAND} />
              {PORTS.map((p) => {
                const [x1, y1] = POINTS[p.at];
                const [x2, y2] = 'lead' in p ? p.lead : [p.x, p.y];
                return <line class="kit-map__lead" x1={x1} y1={y1} x2={x2} y2={y2} />;
              })}
              <path class="kit-map__rest" data-map-rest d="" />
              <path class="kit-map__done" data-map-done d="" />
            </svg>
            {PORTS.map((p) => (
              <span class="kit-map__dot" style={`left:${px(POINTS[p.at][0])};top:${py(POINTS[p.at][1])}`} />
            ))}
            {PORTS.map((p) => (
              <span class={`kit-map__lb kit-map__lb--${p.side}`} style={`left:${px(p.x)};top:${py(p.y)}`}>
                {p.name}
              </span>
            ))}
            <span class="kit-map__sink" data-map-sink hidden style={`left:${px(POINTS.sink[0])};top:${py(POINTS.sink[1])}`} />
            <span class="kit-map__lb kit-map__lb--l" data-map-sink hidden style={`left:${px(SINK_LABEL.x)};top:${py(SINK_LABEL.y)}`}>
              沈んだ所
            </span>
            <span class="kit-map__ship" data-map-ship aria-hidden="true">
              <svg width="26" height="15" viewBox="0 0 26 15">
                <rect x="10" y="1" width="2.4" height="5" />
                <rect x="14.5" y="1" width="2.4" height="5" />
                <rect class="kit-map__deck" x="7" y="5.5" width="13" height="3.5" />
                <path d="M0.5 9h25l-2.6 5H4.5z" />
              </svg>
            </span>
          </div>
        )
      }
      <div class="kit-picto is-plain" data-picto hidden>
        <p class="kit-picto__key">
          <span class="kit-picto__k kit-picto__k--n"><Fragment set:html={person} />1つが約10人</span>
          <span class="kit-picto__k kit-picto__k--s"><Fragment set:html={person} />生き残った</span>
          <span class="kit-picto__k kit-picto__k--d"><Fragment set:html={person} />亡くなった</span>
          <span class="kit-picto__k kit-picto__k--u">（1つが約10人）</span>
        </p>
        <div class="kit-picto__stage" data-picto-stage></div>
      </div>
    </div>

    <div class="kit-slides__bar">
      <button type="button" class:list={['kit-btn', staff && 'kit-slides__staff']} data-slides-prev disabled>← 前へ</button>
      <button type="button" class:list={['kit-btn', staff && 'kit-slides__staff']} data-slides-next>次へ →</button>
      {staff && <button type="button" class="kit-btn kit-slides__staff" data-slides-first disabled>最初から</button>}
      {!staff && <button type="button" class="kit-btn kit-btn--quiet" data-slides-back hidden>いまの頁に戻る</button>}
    </div>
    {
      staff ? (
        <p class="kit-slides__state">前へ・次へ・最初からを押すと、この節を開いているメンバー全員の画面も切り替わります。</p>
      ) : (
        <p class="kit-slides__state" data-slides-state />
      )
    }
    <p class="kit-slides__msg" data-slides-msg aria-live="polite"></p>
    {
      staff &&
        deck.slides.map(
          (s, i) =>
            s.note && (
              <p class="kit-slides__note" data-slide-note={i} hidden={i !== 0}>
                <span class="kit-slides__note-h">話すこと（運営だけ）</span>
                {s.note}
              </p>
            ),
        )
    }
  </div>

  <script type="application/json" data-slides-json set:html={payloadJson} is:inline />
</section>

<script>
  import { setupSlides } from '../../lesson/slides';
  setupSlides();
</script>

<style is:global>
  /* 人の形とラベルは src/lesson/slides.ts が作るので is:global にし、.kit-slides の中だけに効く書き方にする
     （Guess.astro と同じ理由）。色は lesson-tokens.css のものだけ。ボタンは既存の .kit-btn、運営のボタンは
     予想ボードの運営のボタンと同じ琥珀の字と枠。開け閉めの段は左の欄の狭い画面の1行のボタン（.rail__toggle）と同じ形 */
  .kit-slides {
    font-family: var(--font-body);
    font-size: 14px;
    line-height: 1.6;
    color: var(--l-ink);
  }

  .kit-slides:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 3px;
  }

  .kit-slides__toggle {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    width: 100%;
    padding: 6px 12px;
    font: inherit;
    font-size: 14px;
    color: var(--l-ink);
    text-align: left;
    background: var(--l-card);
    border: 1.5px solid var(--color-line);
    border-radius: var(--radius);
    cursor: pointer;
  }

  .kit-slides__toggle:hover {
    background: var(--l-chip);
  }

  .kit-slides.is-closed .kit-slides__in {
    display: none;
  }

  .kit-slides__in {
    margin-top: 8px;
    padding: 12px 12px 10px;
    background: var(--l-card);
    border: 1px solid var(--l-rule);
  }

  /* 高さは src/lesson/slides.ts がいちばん高い1枚に合わせて書く（ボタンの段が動かないように）。1枚は上にそろえる */
  .kit-slides__view {
    container-type: inline-size;
  }

  .kit-slide[hidden],
  .kit-picto[hidden] {
    display: none;
  }

  /* 文字の1枚。短く、大きな字で */
  .kit-slide__title {
    margin: 0 0 8px;
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 21px;
    line-height: 1.45;
    text-indent: 0;
  }

  .kit-slide__line {
    margin: 0 0 6px;
    font-size: 16px;
    line-height: 1.65;
    text-indent: 0;
  }

  .kit-slide__sub {
    margin: 0 0 8px;
    font-size: 14px;
    color: var(--l-ink-2);
    text-indent: 0;
  }

  @container (min-width: 480px) {
    .kit-slide__title {
      font-size: 26px;
    }

    .kit-slide__line {
      font-size: 19px;
    }

    .kit-slide__sub {
      font-size: 15px;
    }
  }

  /* --- 大きな数の1枚（kind: facts）。数は見出しと同じ明朝の太字、説明は薄い墨の小さな字 --- */
  .kit-facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
    gap: 14px 18px;
    margin: 10px 0 4px;
  }

  .kit-facts__item {
    padding-top: 8px;
    border-top: 1px solid var(--l-rule);
  }

  .kit-facts__v {
    margin: 0;
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 28px;
    line-height: 1.25;
    font-variant-numeric: tabular-nums;
  }

  .kit-facts__l {
    margin: 4px 0 0;
    font-size: 13.5px;
    line-height: 1.55;
    color: var(--l-ink-2);
  }

  /* --- 人の図 --- */
  .kit-picto__key {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 14px;
    margin: 0 0 10px;
    font-size: 13px;
    color: var(--l-ink-2);
    text-indent: 0;
  }

  .kit-picto__k {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .kit-picto.is-plain .kit-picto__k--s,
  .kit-picto.is-plain .kit-picto__k--d,
  .kit-picto.is-plain .kit-picto__k--u,
  .kit-picto:not(.is-plain) .kit-picto__k--n {
    display: none;
  }

  .kit-picto__b {
    fill: none;
    stroke: var(--l-died);
    stroke-width: 1.3px;
    vector-effect: non-scaling-stroke;
    transition:
      fill 0.4s,
      stroke 0.4s;
  }

  .kit-picto__k--s .kit-picto__b,
  .kit-picto__ic.is-s .kit-picto__b {
    fill: var(--l-survived);
    stroke: var(--l-survived-edge);
  }

  .kit-picto__k--n .kit-picto__b,
  .kit-picto.is-plain .kit-picto__ic .kit-picto__b {
    fill: none;
    stroke: var(--l-ink-3);
  }

  .kit-picto__stage {
    position: relative;
    transition: height 0.7s cubic-bezier(0.4, 0.1, 0.2, 1);
  }

  .kit-picto__ic {
    position: absolute;
    left: 0;
    top: 0;
    transition: transform 0.7s cubic-bezier(0.4, 0.1, 0.2, 1);
  }

  .kit-picto__ic svg {
    display: block;
  }

  .kit-picto__gl {
    position: absolute;
    left: 0;
    top: 0;
    font-size: 13px;
    line-height: 1.45;
  }

  .kit-picto__gl b {
    font-family: var(--font-head);
    font-size: 14px;
  }

  .kit-picto__gl span {
    white-space: nowrap;
    color: var(--l-ink-2);
    font-variant-numeric: tabular-nums;
  }

  /* 幅が変わったとき・文字の1枚から図に移ったときは動かさずに置く */
  .kit-picto__stage.is-still,
  .kit-picto__stage.is-still .kit-picto__ic,
  .kit-picto__stage.is-still .kit-picto__b {
    transition: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .kit-picto__stage,
    .kit-picto__ic,
    .kit-picto__b {
      transition: none;
    }
  }

  /* --- 写真・絵の1枚 --- */
  .kit-slide__title--img {
    font-size: 17px;
  }

  /* 1枚が1280×800の画面に収まるように、高さに上限を付ける（横長でない絵は幅いっぱいにしない） */
  .kit-slide__img {
    display: block;
    max-width: 100%;
    max-height: 52vh;
    width: auto;
    height: auto;
    margin: 4px auto 0;
    border: 1px solid var(--l-rule);
  }

  .kit-slide__credit {
    margin: 4px 0 0;
    font-size: 11.5px;
    line-height: 1.5;
    color: var(--l-ink-2);
    text-indent: 0;
  }

  @container (min-width: 480px) {
    .kit-slide__title--img {
      font-size: 21px;
    }
  }

  /* --- 航路の地図（陸 = --l-lv1、海 = --l-sea。進んだ道は朱の実線、まだの道は薄い墨の点線） --- */
  .kit-map {
    position: relative;
    margin-top: 6px;
    font-size: 11.5px;
    line-height: 1.3;
  }

  .kit-map[hidden],
  .kit-map [hidden] {
    display: none;
  }

  .kit-map__svg {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--l-rule);
  }

  .kit-map__sea {
    fill: var(--l-sea);
  }

  .kit-map__land {
    fill: var(--l-lv1);
    stroke: var(--l-rule);
    stroke-width: 0.8px;
    vector-effect: non-scaling-stroke;
  }

  .kit-map__lead {
    stroke: var(--l-ink-3);
    stroke-width: 1px;
    vector-effect: non-scaling-stroke;
  }

  .kit-map__rest,
  .kit-map__done {
    fill: none;
    stroke-linejoin: round;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }

  .kit-map__rest {
    stroke: var(--l-ink-3);
    stroke-width: 1.5px;
    stroke-dasharray: 4 4;
  }

  .kit-map__done {
    stroke: var(--l-shu);
    stroke-width: 2.5px;
  }

  .kit-map__dot {
    position: absolute;
    width: 7px;
    height: 7px;
    margin: -5px 0 0 -5px;
    background: var(--l-ink);
    border: 1.5px solid var(--l-card);
    border-radius: 50%;
    box-sizing: content-box;
  }

  .kit-map__lb {
    position: absolute;
    padding: 0 3px;
    white-space: nowrap;
    color: var(--l-ink);
    background: var(--l-card);
    border-radius: 2px;
  }

  .kit-map__lb--r {
    transform: translate(-100%, -50%);
  }

  .kit-map__lb--l {
    transform: translate(0, -50%);
  }

  .kit-map__sink {
    position: absolute;
    width: 26px;
    height: 26px;
    margin: -13px 0 0 -13px;
    border: 1.5px solid var(--l-died);
    border-radius: 50%;
    box-sizing: border-box;
  }

  .kit-map__ship {
    position: absolute;
    left: 0;
    top: 0;
    width: 26px;
    height: 15px;
    margin: -11px 0 0 -13px;
    transition:
      left 1s cubic-bezier(0.4, 0.1, 0.2, 1),
      top 1s cubic-bezier(0.4, 0.1, 0.2, 1);
  }

  .kit-map__ship svg {
    display: block;
    fill: var(--l-ink);
    filter: drop-shadow(0 0 1px var(--l-card)) drop-shadow(0 0 1px var(--l-card));
  }

  .kit-map__ship .kit-map__deck {
    fill: var(--l-card);
    stroke: var(--l-ink);
    stroke-width: 1px;
  }

  .kit-map.is-still .kit-map__ship {
    transition: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .kit-map__ship {
      transition: none;
    }
  }

  /* 本文の幅いっぱい（約700px）。上の決まりより後ろに置くこと（同じ強さなので後ろが勝つ）。みんなで同じ1枚を見るので、字・図をもう一段大きく */
  @container (min-width: 600px) {
    .kit-slide__title {
      font-size: 30px;
    }

    .kit-slide__line {
      font-size: 21px;
    }

    .kit-slide__sub {
      font-size: 16px;
    }

    .kit-picto__key {
      font-size: 15px;
    }

    .kit-picto__gl {
      font-size: 15px;
    }

    .kit-picto__gl b {
      font-size: 16px;
    }

    .kit-facts__v {
      font-size: 34px;
    }

    .kit-facts__l {
      font-size: 15px;
    }

    .kit-slide__title--img {
      font-size: 24px;
    }

    .kit-slide__credit {
      font-size: 12.5px;
    }

