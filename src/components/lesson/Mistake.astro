---
/**
 * <Mistake> — よくある間違い（10-lesson-and-writing.md 第6.1節）。
 * 壊れたコード・出るエラーメッセージ・原因と直し方の3つを持つ。
 * エラーメッセージは訳さずそのまま載せる（第5章）。
 *
 * ここの error は採点の応答にも使う。学習者の提出でエラーが出たとき、
 * この文字列と前方一致すればこの説明を出す（20-platform.md 第4.3節）。
 */
import RunBox from '../../lesson/ui/RunBox';
import { nextId } from '../../lesson/ui/ids';

interface Props {
  /** 採点から参照するための id */
  id: string;
  /** 初学者が実際に書く形の壊れたコード */
  code: string;
  /** 実際に出るエラーメッセージ */
  error: string;
  stdin?: string;
}

const { id, code, error, stdin } = Astro.props;
const key = nextId('mistake');
/* エラーの種類（`SyntaxError: ...` の先頭）。閉じたままでも何の失敗かが分かるように、
   札の横に添える。書き手に書かせない（error から取れるものを二度書かせない）。 */
const kind = (error.match(/^[A-Za-z]+Error/) ?? [])[0] ?? '';
---

<details class="kit-mistake" id={id}>
  {/* 既定では閉じる（10-lesson-and-writing.md 第6章）。本文を読み進める途中で、
      まだ起きていない失敗を広げて見せる理由がない。開きたい人だけが開く。
      閉じていても採点からは参照され、同じエラーを出した人にはその場で出る。 */}
  <summary class="kit-mistake__label">
    よくある間違い{kind && <span class="kit-mistake__kind">{kind}</span>}
  </summary>
  <div class="kit-mistake__in">
    <RunBox client:load code={code} expected={error} stdin={stdin} broken editorId={key} />
    <div class="kit-mistake__fix"><slot /></div>
  </div>
</details>