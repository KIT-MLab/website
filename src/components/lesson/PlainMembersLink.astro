---
/**
 * メンバーでない人に渡す、本文のリンク（MDX の `a`）の代わり（design/spec/53-ml-intro.md 第7節）。
 *
 * 本文の「入口2」は remark-section-links.mjs がリンクにする。行き先がメンバーだけの章
 * （scripts/parts.mjs の MEMBERS_ONLY_CHAPTERS）なら、メンバーでない人には開けないので、
 * リンクにせず文字だけにする。それ以外のリンクは、もとの属性のまま <a> で出す。
 *
 * 節のページと練習問題集の話題のページが、メンバーでない人にだけ `components={{ a: … }}` で渡す。
 */
import { isMembersOnlyChapter } from '../../lesson/chapters';

const { href, className, class: cls, ...rest } = Astro.props as Record<string, unknown> & { href?: string };
const chapter = typeof href === 'string' ? (/^\/learn\/lesson\/([^/]+)\//.exec(href)?.[1] ?? '') : '';
const plain = chapter !== '' && isMembersOnlyChapter(chapter);
const klass = (cls ?? className) as string | undefined;
---

{plain ? <span><slot /></span> : <a href={href} class={klass} {...rest}><slot /></a>}
