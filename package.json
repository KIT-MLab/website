{
  "name": "c-users-haruk-desktop-ml-project-site",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run build:tests && astro dev",
    "check:lessons": "node scripts/check-lessons.mjs",
    "check:weekly": "node scripts/check-weekly.mjs",
    "check:practice": "node scripts/check-practice.mjs",
    "build:tests": "node scripts/build-tests.mjs",
    "report:combos": "node scripts/combos.mjs",
    "report:weekly": "node scripts/report-weekly.mjs",
    "report:practice": "node scripts/report-practice.mjs",
